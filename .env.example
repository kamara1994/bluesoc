# Set these in the Vercel project environment (as Secret where available).
# DO NOT fill this file with real tokens or commit a populated .env file.
BLUE_SOC_ADMIN_TOKEN=generate-a-unique-random-token-with-at-least-32-characters
BLUE_SOC_JSONBIN_ID=your-jsonbin-record-id
# Prefer a read-only JSONBin access key scoped to just the needed bin.
BLUE_SOC_JSONBIN_READ_KEY=your-jsonbin-read-only-access-key
# If required, use a newly rotated master key on the SERVER ONLY:
# BLUE_SOC_JSONBIN_MASTER_KEY=server-only-rotated-key
BLUE_SOC_SCAN_WEBHOOK=https://your-protected-n8n.example/webhook/scan
BLUE_SOC_CHAT_WEBHOOK=https://your-protected-n8n.example/webhook/chat
# Must be explicitly enabled after confirming that the n8n workflow has its
# own approval, protected IP allowlist and rollback controls.
BLUE_SOC_ALLOW_SCAN=false
